{"name": "GN_Forest",
 "inputs": [["Geometry", "GEOMETRY"],
            ["Radius", "FLOAT", 0.0, {"min": 0}],
            ["Front", "FLOAT", 1.2, {"min": 0.01}],
            ["Spacing", "FLOAT", 0.45, {"min": 0.05}],
            ["Density", "FLOAT", 3.5, {"min": 0}],
            ["Seed", "INT", 3],
            ["Trees", "COLLECTION"],
            ["Ring", "MATERIAL"],
            ["Ring Width", "FLOAT", 0.03, {"min": 0}]],
 "outputs": [["Geometry", "GEOMETRY"]],
 "nodes": {
   "nrm":  ["GeometryNodeInputNormal"],
   "nsep": ["ShaderNodeSeparateXYZ"],
   "flat": ["ShaderNodeMath", {"operation": "GREATER_THAN"}, {"1": 0.8}],
   "dist": ["GeometryNodeDistributePointsOnFaces", {"distribute_method": "POISSON"}],

   "pos":  ["GeometryNodeInputPosition"],
   "psep": ["ShaderNodeSeparateXYZ"],
   "pxy":  ["ShaderNodeCombineXYZ"],
   "dlen": ["ShaderNodeVectorMath", {"operation": "LENGTH"}],
   "lo":   ["ShaderNodeMath", {"operation": "SUBTRACT"}],
   "grow": ["ShaderNodeMapRange", {"interpolation_type": "SMOOTHSTEP"}, {"To Min": 1.0, "To Max": 0.0}],
   "rsz":  ["FunctionNodeRandomValue", {"data_type": "FLOAT"}, {"Min": 0.26, "Max": 0.5}],
   "size": ["ShaderNodeMath", {"operation": "MULTIPLY"}],

   "rang": ["FunctionNodeRandomValue", {"data_type": "FLOAT"}, {"Min": 0.0, "Max": 6.2832, "Seed": 17}],
   "eul":  ["ShaderNodeCombineXYZ"],
   "rot":  ["FunctionNodeEulerToRotation"],
   "pick": ["FunctionNodeRandomValue", {"data_type": "INT"}, {"Min": 0, "Max": 4, "Seed": 29}],
   "coll": ["GeometryNodeCollectionInfo", {"transform_space": "ORIGINAL"},
            {"Separate Children": true, "Reset Children": true}],
   "inst": ["GeometryNodeInstanceOnPoints", {}, {"Pick Instance": true}],

   "circ": ["GeometryNodeCurvePrimitiveCircle", {"mode": "RADIUS"}, {"Resolution": 160}],
   "cpos": ["GeometryNodeInputPosition"],
   "up":   ["ShaderNodeVectorMath", {"operation": "ADD"}, {"1": [0.0, 0.0, 20.0]}],
   "ray":  ["GeometryNodeRaycast", {}, {"Ray Direction": [0.0, 0.0, -1.0], "Ray Length": 40.0}],
   "lift": ["ShaderNodeVectorMath", {"operation": "ADD"}, {"1": [0.0, 0.0, 0.04]}],
   "onto": ["GeometryNodeSetPosition"],
   "prof": ["GeometryNodeCurvePrimitiveCircle", {"mode": "RADIUS"}, {"Resolution": 8}],
   "tube": ["GeometryNodeCurveToMesh"],
   "rmat": ["GeometryNodeSetMaterial"],
   "join": ["GeometryNodeJoinGeometry"]},
 "links": [
   ["nrm.Normal", "nsep.Vector"], ["nsep.Z", "flat.0"],
   ["in.Geometry", "dist.Mesh"], ["flat.Value", "dist.Selection"], ["in.Spacing", "dist.Distance Min"],
   ["in.Density", "dist.Density Max"], ["in.Seed", "dist.Seed"],

   ["pos.Position", "psep.Vector"], ["psep.X", "pxy.X"], ["psep.Y", "pxy.Y"], ["pxy.Vector", "dlen.Vector"],
   ["dlen.Value", "grow.Value"], ["in.Radius", "lo.0"], ["in.Front", "lo.1"],
   ["lo.Value", "grow.From Min"], ["in.Radius", "grow.From Max"],
   ["in.Seed", "rsz.Seed"], ["rsz.Value", "size.0"], ["grow.Result", "size.1"],

   ["rang.Value", "eul.Z"], ["eul.Vector", "rot.Euler"],
   ["in.Trees", "coll.Collection"],
   ["dist.Points", "inst.Points"], ["coll.Instances", "inst.Instance"], ["pick.Value", "inst.Instance Index"],
   ["rot.Rotation", "inst.Rotation"], ["size.Value", "inst.Scale"],

   ["in.Radius", "circ.Radius"],
   ["cpos.Position", "up.0"], ["in.Geometry", "ray.Target Geometry"], ["up.Vector", "ray.Source Position"],
   ["ray.Hit Position", "lift.0"], ["circ.Curve", "onto.Geometry"], ["lift.Vector", "onto.Position"],
   ["in.Ring Width", "prof.Radius"], ["onto.Geometry", "tube.Curve"], ["prof.Curve", "tube.Profile Curve"],
   ["tube.Mesh", "rmat.Geometry"], ["in.Ring", "rmat.Material"],

   ["in.Geometry", "join.Geometry"], ["inst.Instances", "join.Geometry"], ["rmat.Geometry", "join.Geometry"],
   ["join.Geometry", "out.Geometry"]]}
